<launch>
    <!-- node_name -->
    <arg name="node_name"          default="bbox_to_tf"/>

    <!-- base_frame_name -->
    <arg name="base_frame_name"          default="base_footprint"/>

    <!-- Topic name (sobits_msgs/BoundingBoxes) -->
    <arg name="bbox_topic_name"          default="objects_rect"/>

    <!-- Topic name (sensor_msgs/PointCloud2) -->
    <arg name="cloud_topic_name"         default="/points2"/>

    <!-- Topic name (sensor_msgs/Image) -->
    <arg name="img_topic_name"           default="/rgb/image_raw"/>

    <!-- ON/OFF (bool) -->
    <arg name="execute_default"          default="true"/>

    <!-- same point cloud range -->
    <arg name="cluster_tolerance"        default="0.008"/>

    <!-- clustering point cloud lower number of pieces -->
    <arg name="min_clusterSize"          default="10"/>

    <!-- clustering point cloud upper number of pieces -->
    <arg name="max_clusterSize"           default="2000000"/>

    <!-- limiter of object point cloud cut noise -->
    <arg name="noise_point_cloud_range"          default="0.01"/>

    <node pkg="bbox_to_tf" exec="bbox_to_tf" name="$(var node_name)" output="screen">
        <param name="node_name"                value="$(var node_name)" />
        <param name="base_frame_name"          value="$(var base_frame_name)" />
        <param name="bbox_topic_name"          value="$(var bbox_topic_name)" />
        <param name="cloud_topic_name"         value="$(var cloud_topic_name)" />
        <param name="img_topic_name"           value="$(var img_topic_name)" />
        <param name="execute_default"          value="$(var execute_default)" />
        <param name="cluster_tolerance"        value="$(var cluster_tolerance)" />
        <param name="min_clusterSize"          value="$(var min_clusterSize)"/>
        <param name="max_clusterSize"          value="$(var max_clusterSize)"/>
        <param name="noise_point_cloud_range"  value="$(var noise_point_cloud_range)"/>
    </node>

    <arg name="rviz"                    default="false"/>
    <node if="$(var rviz)" pkg="rviz2" exec="rviz2" args="-d $(find-pkg-share bbox_to_tf)/config/bbox_to_tf.rviz"/>
</launch>